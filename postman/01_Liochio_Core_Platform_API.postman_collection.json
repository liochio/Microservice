              }
            ],
            "url": {
              "raw": "{{coreUrl}}/api/v1/auth/verify-otp",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Kích hoạt tài khoản ACTIVE và tự động cấp phát 3 tài khoản Sổ cái kép Core + Ví tiền App DB.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"username\": \"{{registeredUsername}}\",\n  \"otpCode\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Xác thực OTP thành công\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 Đăng nhập SuperAdmin (Login SuperAdmin - Full 24 Quyền)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "vi-VN",
                "type": "text"
              },
