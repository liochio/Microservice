                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Tenant-ID",
                "value": "default",
                "type": "text"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceId}}",
                "type": "text"
              },
              {
                "key": "X-Platform",
                "value": "POSTMAN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{coreUrl}}/api/v1/auth/login",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập SuperAdmin nhận Token RS256 chứa 24/24 quyền hệ thống.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"Password123@\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    if (jsonData.data.accessToken) {",
                  "        pm.collectionVariables.set(\"coreToken\", jsonData.data.accessToken);",
                  "        console.log(\"Captured Core Token: \" + jsonData.data.accessToken);",
                  "    }",
                  "    if (jsonData.data.refreshToken) {",
                  "        pm.collectionVariables.set(\"coreRefreshToken\", jsonData.data.refreshToken);",
                  "    }",
                  "    if (jsonData.data.userId || jsonData.data.id) {",
                  "        var uId = jsonData.data.userId || jsonData.data.id;",
                  "        pm.collectionVariables.set(\"coreUserId\", uId.toString());",
                  "    }",
                  "    if (jsonData.data.sessionId) {",
                  "        pm.collectionVariables.set(\"coreSessionId\", jsonData.data.sessionId);",
                  "    }",
                  "}",
                  "pm.test(\"Status code is 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
