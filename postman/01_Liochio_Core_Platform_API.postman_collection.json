  "item": [
    {
      "name": "01. Core Authentication & Identity (IAM)",
      "description": "Xác thực tập trung, kiểm soát brute-force, thách thức 2FA, cấp phát tài khoản tự động.",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản mới (Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "vi-VN",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Tenant-ID",
                "value": "default",
                "type": "text"
              },
              {
                "key": "X-Device-ID",
                "value": "{{deviceId}}",
                "type": "text"
              },
              {
                "key": "X-Platform",
                "value": "POSTMAN",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{coreUrl}}/api/v1/auth/register",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Tạo tài khoản ở trạng thái PENDING_VERIFY và sinh mã OTP 6 số thực tế qua Email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"client_demo_2026_new\",\n  \"password\": \"Password123!\",\n  \"email\": \"client_demo_2026_new@liochio.vn\",\n  \"fullName\": \"Liochio New Customer 2026\",\n  \"roles\": [\n    \"ROLE_CUSTOMER\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.test(\"Đăng ký thành công\", function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "    if (res.data) {",
                  "        pm.collectionVariables.set(\"coreUserId\", res.data.id.toString());",
                  "        pm.collectionVariables.set(\"registeredEmail\", res.data.email);",
                  "        pm.collectionVariables.set(\"registeredUsername\", res.data.username);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Xác thực OTP kích hoạt tài khoản (Verify OTP)",
